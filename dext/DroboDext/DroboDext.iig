// DroboDext declarations. The iig compiler turns this into the meta classes
// and dispatch machinery the dext needs; dext/Makefile runs it before
// compiling DroboDext.cpp.
//
// The driver subclasses Apple's IOUserSCSIPeripheralDeviceType00: the
// framework matches the Drobo's SCSI LUN, and UserSendCDB gives us the
// pass-through that both user-space transports could not provide on macOS 27.
// UserSuspendServices/UserResumeServices are the exclusive-access session
// (the old eject dance, built in).
//
// No member declarations here: instance state lives in a DroboDextDriver_IVars
// struct defined in DroboDext.cpp, reached through the generated `ivars`
// pointer. DriverKit does not allocate it; init() does.

#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>
#include <SCSIPeripheralsDriverKit/IOUserSCSIPeripheralDeviceType00.iig>

class DroboDextDriver : public IOUserSCSIPeripheralDeviceType00
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService* provider) override;
    virtual kern_return_t UserDetermineDeviceCharacteristics(bool* result) override;
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient** userClient) override;
};

class DroboUserClient : public IOUserClient
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService* provider) override;
    virtual kern_return_t Stop(IOService* provider) override;
    virtual kern_return_t ExternalMethod(uint64_t selector,
                                         IOUserClientMethodArguments* arguments,
                                         const IOUserClientMethodDispatch* dispatch,
                                         OSObject* target, void* reference) override;
};
